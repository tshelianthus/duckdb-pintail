query T
SELECT st_astext(st_pointfromgeohash('9qqj7nmxncgyy4d0dbxqz0',4));
----
POINT (-115.13671875 36.123046875)

query T
SELECT st_astext(st_geomfromgeohash('9qqj7nmxncgyy4d0dbxqz0',4));
----
POLYGON ((-115.3125 36.03515625, -115.3125 36.2109375, -114.9609375 36.2109375, -114.9609375 36.03515625, -115.3125 36.03515625))

query I
SELECT st_box2dfromgeohash('9qqj7nmxncgyy4d0dbxqz0',10) = st_geohash_bbox('9qqj7nmxncgyy4d0dbxqz0',10);
----
true

statement ok
CREATE TABLE gh_batch AS SELECT i, CASE WHEN i%7=0 THEN NULL::GEOMETRY WHEN i%7=1 THEN 'POINT EMPTY'::GEOMETRY ELSE ('POINT(' || (i%350-175) || ' ' || (i%170-85) || ')')::GEOMETRY END g, CASE WHEN i%11=0 THEN NULL ELSE (i%20+1)::INTEGER END p FROM range(10000) t(i);

query I
SELECT count(*) = 10000 AND count(st_geohash(g)) = count(g) FILTER (WHERE i%7<>1) AND count(st_geohash(g,p)) = count(g) FILTER (WHERE i%7<>1 AND p IS NOT NULL) FROM gh_batch;
----
true

query I
SELECT bool_and(length(st_geohash(g,p)) = p AND st_geohash(g,p) = left(st_geohash(g),p)) FROM gh_batch WHERE i%7>1 AND p IS NOT NULL AND i%3=0;
----
true

query I
SELECT count(st_geohash_bbox(st_geohash(g,p),p)) = count(st_geohash(g,p)) AND bool_and(st_geohash_bbox(st_geohash(g,p),p) = st_geohash_bbox(st_geohash(g,p))) FROM gh_batch;
----
true

query I
SELECT st_geohash_bbox('c0w3h',2) = st_geohash_bbox('c0') FROM range(3);
----
true
true
true

query I
SELECT st_geohash_bbox(NULL::VARCHAR,2) IS NULL FROM range(3);
----
true
true
true

query I
SELECT bool_and(st_geohash_bbox('c0w3h',p) = st_geohash_bbox(left('c0w3h',p))) FROM (VALUES (0),(1),(3),(5)) t(p);
----
true

query I
SELECT count(st_box2dfromgeohash(st_geohash(g,p),p)) = count(st_geohash(g,p)) AND bool_and(st_box2dfromgeohash(st_geohash(g,p),p) = st_box2dfromgeohash(st_geohash(g,p))) FROM gh_batch;
----
true

query I
SELECT st_box2dfromgeohash('c0w3h',2) = st_box2dfromgeohash('c0') FROM range(3);
----
true
true
true

query I
SELECT st_box2dfromgeohash(NULL::VARCHAR,2) IS NULL FROM range(3);
----
true
true
true

query I
SELECT bool_and(st_box2dfromgeohash('c0w3h',p) = st_box2dfromgeohash(left('c0w3h',p))) FROM (VALUES (0),(1),(3),(5)) t(p);
----
true

query I
SELECT count(st_geohash_neighbors(st_geohash(g,5))) = count(st_geohash(g,5)) FROM gh_batch WHERE i%3=0;
----
true

statement ok
CREATE TABLE gh_extents AS SELECT i, ((i*17)%340-170)::DOUBLE x0, ((i*13)%160-80)::DOUBLE y0, pow(10,-(i%7)) w FROM range(3000) t(i);

statement ok
CREATE TABLE gh_cover AS SELECT *, st_geohash(('LINESTRING(' || x0 || ' ' || y0 || ',' || (x0+w) || ' ' || (y0+w) || ')')::GEOMETRY) h FROM gh_extents;

query I
SELECT bool_and(b.min_lon <= x0 AND b.max_lon >= x0+w AND b.min_lat <= y0 AND b.max_lat >= y0+w) FROM (SELECT *, st_geohash_bbox(h) b FROM gh_cover);
----
true

query I
SELECT count(*) = 0 FROM gh_cover, unnest(string_split('0123456789bcdefghjkmnpqrstuvwxyz','')) a(c) WHERE length(h)<20 AND (st_geohash_bbox(h||c)).min_lon <= x0 AND (st_geohash_bbox(h||c)).max_lon >= x0+w AND (st_geohash_bbox(h||c)).min_lat <= y0 AND (st_geohash_bbox(h||c)).max_lat >= y0+w;
----
true

query I
SELECT bool_and(st_geohash(('LINESTRING(' || x0 || ' ' || y0 || ',' || (x0+w) || ' ' || (y0+w) || ')')::GEOMETRY,2) = left(h,2)) FROM gh_cover;
----
true

query T
SELECT st_geohash(g,5) FROM (VALUES (true,'POINT(-126 48)'::GEOMETRY),(false,'POINT(181 0)'::GEOMETRY)) t(ok,g) WHERE ok;
----
c0w3h

# Core normalizes big-endian WKB before Pintail receives it.
query I
SELECT st_geohash(st_geomfromwkb(unhex('0000000001C05F8000000000004048000000000000')),5) = 'c0w3h';
----
true

query I
SELECT st_geohash('GEOMETRYCOLLECTION Z(POINT Z EMPTY, POINT Z(-126 48 nan))'::GEOMETRY) = 'c0w3hf1s70w3hf1s70w3';
----
true

query I
SELECT st_geohash('LINESTRING(0 -10,0 -9)'::GEOMETRY) = st_geohash('POLYGON((0 -10,0 -9,0 -10,0 -10))'::GEOMETRY);
----
true

query I
SELECT count(*) = 4 FROM duckdb_functions() WHERE function_name='st_geohash';
----
true

query I
SELECT typeof(st_box2dfromgeohash('c0w3h',3)) = typeof(st_geohash_bbox('c0w3h',3));
----
true

query I
SELECT st_geohash(st_setcrs(NULL::GEOMETRY,'EPSG:3857'),5) IS NULL AND st_geohash('POINT(181 0)'::GEOMETRY,NULL) IS NULL;
----
true

# Constant hash with flat precision and NULL validity; flatten/slice a stored nested result.
statement ok
CREATE TABLE gh_nested AS SELECT i, st_box2dfromgeohash('C0W3H',CASE WHEN i%9=0 THEN NULL ELSE (i%6)::INTEGER END) b, st_geohash_neighbors('c0w3h') n FROM range(5000) t(i);

query I
SELECT count(b) = count(*) FILTER (WHERE i%9<>0) AND bool_and(list_count(n)=8) FROM gh_nested WHERE i%2=1;
----
true

query I
SELECT (st_geohash_bbox('c0w3h',NULL)).min_lon IS NULL FROM range(3);
----
true
true
true

statement error
SELECT st_geohash_neighbors('C0W3H');
----
<REGEX>:Invalid Input Error.*Base32.*

statement error
SELECT st_geohash_neighbors('');
----
<REGEX>:Invalid Input Error.*length.*

# Integer extremes and very long valid hashes are safe decoder inputs.
query I
SELECT st_geohash_bbox('c0w3h',-2147483648) = st_geohash_bbox('c0w3h',2147483647) AND st_box2dfromgeohash(repeat('z',10000)).max_lon=180;
----
true
