query I
SELECT bool_and(st_geohash(st_geomfromgeohash(h)) = lower(h)) FROM (VALUES ('s'),('c0w3h'),('upb'),('h00'),('xbp'),('800'),('0'),('z'),('u4pru')) v(h);
