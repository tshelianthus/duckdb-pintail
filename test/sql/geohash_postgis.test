# Whole-geometry Geohash contract, including deliberate PostGIS differences.
require pintail

query I
SELECT count(*) = 0 FROM duckdb_extensions() WHERE extension_name = 'spatial' AND loaded;
----
true

query T
SELECT st_geohash('POINT(-126 48)'::GEOMETRY);
----
c0w3hf1s70w3hf1s70w3

query I
SELECT st_geohash('POINT(-126 48)'::GEOMETRY,0) = st_geohash('POINT(-126 48)'::GEOMETRY);
----
true

query T
SELECT st_geohash('LINESTRING(-126 48,-126.1 48.1)'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('LINESTRING(-126 48,-126.1 48.1)'::GEOMETRY,20) = 'c0w3' AND st_geohash('LINESTRING(-126 48,-126.1 48.1)'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('POLYGON((-126 48,-126.1 48,-126.1 48.1,-126 48))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('POLYGON((-126 48,-126.1 48,-126.1 48.1,-126 48))'::GEOMETRY,20) = 'c0w3' AND st_geohash('POLYGON((-126 48,-126.1 48,-126.1 48.1,-126 48))'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('MULTIPOINT((-126 48),(-126.1 48.1))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('MULTIPOINT((-126 48),(-126.1 48.1))'::GEOMETRY,20) = 'c0w3' AND st_geohash('MULTIPOINT((-126 48),(-126.1 48.1))'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('MULTILINESTRING((-126 48,-126.1 48.1))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('MULTILINESTRING((-126 48,-126.1 48.1))'::GEOMETRY,20) = 'c0w3' AND st_geohash('MULTILINESTRING((-126 48,-126.1 48.1))'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('MULTIPOLYGON(((-126 48,-126.1 48,-126.1 48.1,-126 48)))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('MULTIPOLYGON(((-126 48,-126.1 48,-126.1 48.1,-126 48)))'::GEOMETRY,20) = 'c0w3' AND st_geohash('MULTIPOLYGON(((-126 48,-126.1 48,-126.1 48.1,-126 48)))'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('GEOMETRYCOLLECTION(POINT(-126 48),LINESTRING(-126.1 48.1,-126 48))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('GEOMETRYCOLLECTION(POINT(-126 48),LINESTRING(-126.1 48.1,-126 48))'::GEOMETRY,20) = 'c0w3' AND st_geohash('GEOMETRYCOLLECTION(POINT(-126 48),LINESTRING(-126.1 48.1,-126 48))'::GEOMETRY,2) = 'c0';
----
true

query T
SELECT st_geohash('GEOMETRYCOLLECTION(POINT EMPTY,GEOMETRYCOLLECTION(LINESTRING EMPTY,LINESTRING(-126 48,-126.1 48.1)))'::GEOMETRY);
----
c0w3

query I
SELECT st_geohash('GEOMETRYCOLLECTION(POINT EMPTY,GEOMETRYCOLLECTION(LINESTRING EMPTY,LINESTRING(-126 48,-126.1 48.1)))'::GEOMETRY,20) = 'c0w3' AND st_geohash('GEOMETRYCOLLECTION(POINT EMPTY,GEOMETRYCOLLECTION(LINESTRING EMPTY,LINESTRING(-126 48,-126.1 48.1)))'::GEOMETRY,2) = 'c0';
----
true

query I
SELECT st_geohash('POINT EMPTY'::GEOMETRY) IS NULL AND st_geohash('POINT EMPTY'::GEOMETRY,5) IS NULL;
----
true

query I
SELECT st_geohash('LINESTRING EMPTY'::GEOMETRY) IS NULL AND st_geohash('LINESTRING EMPTY'::GEOMETRY,5) IS NULL;
----
true

query I
SELECT st_geohash('POLYGON EMPTY'::GEOMETRY) IS NULL AND st_geohash('POLYGON EMPTY'::GEOMETRY,5) IS NULL;
----
true

query I
SELECT st_geohash('MULTIPOINT EMPTY'::GEOMETRY) IS NULL AND st_geohash('MULTIPOINT EMPTY'::GEOMETRY,5) IS NULL;
----
true

query I
