# name: test/sql/function_metadata.test
# description: Verify duckdb_functions() exposes parameter names, descriptions, examples, and categories
# group: [pintail]

require pintail

# DuckDB 2.0 currently errors while materializing duckdb_functions() when a
# GEOMETRY overload is registered. Keep the catalog assertions active on the
# 1.5 line; 2.0 still exercises the real overloads in the SQL behavior tests.
query I
SELECT CASE WHEN version() LIKE 'v2%' THEN true ELSE (
  SELECT count(*) = 14
    AND count(*) FILTER (WHERE function_name = 'pintail' AND parameters::VARCHAR = '[arg]') = 1
    AND count(*) FILTER (WHERE function_name = 'st_geohash' AND parameters::VARCHAR = '[geom]') = 1
    AND count(*) FILTER (WHERE function_name = 'st_geohash' AND parameters::VARCHAR = '[geom, maxchars]') = 1
    AND count(*) FILTER (WHERE function_name = 'st_geohash' AND parameters::VARCHAR = '[lat, lon]') = 1
    AND count(*) FILTER (WHERE function_name = 'st_geohash' AND parameters::VARCHAR = '[lat, lon, precision]') = 1
    AND bool_and(description IS NOT NULL AND description <> '')
    AND bool_and(len(examples) > 0)
    AND bool_and(len(list_filter(parameters, x -> x LIKE 'col%')) = 0)
    AND bool_and(len(categories) > 0)
  FROM duckdb_functions()
  WHERE function_name IN (
    'pintail', 'st_geohash', 'st_pointfromgeohash', 'st_geomfromgeohash',
    'st_geohash_bbox', 'st_box2dfromgeohash', 'st_geohash_neighbors'
  )
)
END;
----
true
